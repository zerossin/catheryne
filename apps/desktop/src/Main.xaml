      <CheckBox x:Name="AutoUpdate" Content="호환 버전 자동 업데이트" ToolTip="게임 실행 전에 공식 파일을 검증하고 업데이트합니다."/>
</StackPanel></Border>
      <StackPanel x:Name="SetupComponents"/>
      <TextBlock x:Name="SetupErrorDetails" TextWrapping="Wrap" Foreground="#D8C79E" Margin="0,12,0,0"/>
      </StackPanel></Expander>
     </StackPanel>
